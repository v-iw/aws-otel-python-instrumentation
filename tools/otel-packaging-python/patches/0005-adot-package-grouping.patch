+def _adot_group_packages(current_site):
+    # ADOT patch 0005: package grouping (B2). build.sh moves every distribution that is not OpenTelemetry's or the
+    # ADOT distro's to <site>/deps, which goes at the end of sys.path, behind the application's site-packages: the
+    # application keeps its own versions of general libraries (urllib3, protobuf, requests, ...), which make no
+    # compatibility promise and which the SDK requires only loosely. The OpenTelemetry group stays ahead of them (patch
+    # 0002): the SDK needs the API version it was built with, and the API promises backward compatibility.
+    # PYTHONPATH is left alone; child processes run this file again.
+    deps = join(current_site, "deps")
+    if not isdir(deps):
+        return
+    normalized_deps = normpath(deps)
+    path[:] = [entry for entry in path if normpath(entry) != normalized_deps]
+    path.append(deps)
+    _log_debug("using general libraries from {}, after the application's".format(deps))
 
 
+def _adot_pin_opentelemetry_namespace():
+    # ADOT patch 0005: opentelemetry is a namespace package, whose __path__ is recomputed whenever sys.path changes.
+    # An application that later moves its own site-packages forward would then get every opentelemetry module not
+    # imported yet from its own copies, next to ours. Pinned to what it is now, with this site first.
+    try:
+        import opentelemetry
+        opentelemetry.__path__ = list(opentelemetry.__path__)
+    except Exception as e:
+        _log_debug("cannot pin the opentelemetry namespace: {}: {}".format(type(e).__name__, e))
+
