+# ADOT patch 0004: hooks into ADOT's _adot_hooks.py, installed next to this file. It writes the skip record (A6) and
+# the stderr line, removes the variables the operator set, and undoes a failed initialization (B4). It is loaded the
+# way the shim loads this file (compiled from its path, not imported), so that it works on every interpreter this
+# file reaches and whether or not this directory is still on sys.path. A missing or failing hook changes no decision.
+_adot_hooks = None
 
 
+def _adot_hook(name, *args):
+    global _adot_hooks
+    try:
+        if _adot_hooks is None:
+            hooks_file = join(dirname(__file__), "_adot_hooks.py")
+            namespace = {"__name__": "_adot_hooks", "__file__": hooks_file}
+            with open(hooks_file, "rb") as hooks_source:
+                exec(compile(hooks_source.read(), hooks_file, "exec"), namespace)
+            _adot_hooks = namespace
+        return _adot_hooks[name](*args)
+    except Exception:
+        return None
+
+
+def _log_cannot_auto_instrument_warning(reason, code="bootstrap_error"):
+    # ADOT patch 0004: every caller names its reason code, and the line no longer carries sys.argv, whose arguments
+    # can hold passwords.
+    if _adot_hook("skip", code, reason):
+        return
+    _log_warn("cannot auto-instrument Python process: {}".format(reason))
